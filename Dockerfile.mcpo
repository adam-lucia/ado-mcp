# Multi-stage build for ADO MCP Server with mcpo HTTP wrapper
# This combines the working stdio MCP server with mcpo for remote HTTP access

# Build stage for MCP server
FROM node:20-bullseye AS mcp-builder

ENV NODE_ENV=development
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
COPY . .
RUN npm ci && npm run build

# Python stage for mcpo
FROM python:3.12-slim AS mcpo-builder

RUN pip install --no-cache-dir mcpo

# Final production stage
FROM node:20-bullseye-slim

ENV NODE_ENV=production

# Install Python and required packages
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install mcpo
RUN pip3 install --no-cache-dir mcpo

WORKDIR /app

# Copy built MCP server
COPY --from=mcp-builder /app/build ./build
COPY --from=mcp-builder /app/package*.json ./
COPY --from=mcp-builder /app/config ./config

# Install only production dependencies
RUN npm ci --only=production

# Copy startup script
COPY docker-entrypoint-mcpo.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-mcpo.sh

# Expose mcpo HTTP port
EXPOSE 8000

# Health check for mcpo
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["docker-entrypoint-mcpo.sh"]
